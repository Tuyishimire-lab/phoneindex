// Prisma schema for PhoneIndex: AI-driven smartphone intelligence platform
// Supports PostgreSQL + pgvector for multi-source evidence retrieval

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum EditorPersonaId {
  SILICON_GEEK
  CAMERA_PURIST
  PRAGMATIST
  DAILY_DRIVER
}

enum BuyRecommendation {
  STRONG_BUY
  BUY_ON_SALE
  WAIT_FOR_DROP
  SKIP
}

enum DraftStatus {
  PENDING_REVIEW
  APPROVED_PUBLISHED
  AUTO_PUBLISHED
  REJECTED
}

model Device {
  id                  String            @id @default(cuid())
  slug                String            @unique
  brand               String
  name                String
  releaseDate         DateTime
  launchMsrpUsd       Int
  currentStreetUsd    Int
  osSupportYears      Int
  compositeLivingScore Float
  buyRecommendation   BuyRecommendation

  specs               DeviceSpecs?
  editorVerdicts      EditorVerdict[]
  evidenceChunks      EvidenceChunk[]
  affiliateOffers     AffiliateOffer[]
  priceHistory        PricePoint[]
  editorialDrafts     EditorialDraft[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model DeviceSpecs {
  id                  String   @id @default(cuid())
  deviceId            String   @unique
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Silicon & Performance
  socName             String
  socNodeNm           Int
  cpuTopology         String
  gpuName             String
  ramOptions          String
  storageType         String   // e.g., UFS 4.0, NVMe
  geekbenchSingle     Int
  geekbenchMulti      Int
  wildlifeStabilityPct Float   // 3DMark Wild Life Extreme Stability %

  // Display & PWM
  displaySizeInch     Float
  displayPanelType    String
  resolution          String
  refreshRateHz       String
  peakBrightnessNits  Int
  pwmDimmingHz        Int

  // Camera System
  mainSensorSize      String   // e.g., 1/1.3", 1.0"
  mainSensorMp        Int
  mainAperture        String
  telephotoSpecs      String
  ultrawideSpecs      String
  videoCapabilities   String
  shutterLagRating    String

  // Battery & Thermals
  batteryCapacityMah  Int
  batteryChemistry    String   // e.g., Silicon-Carbon Li-Si, Standard Li-Ion
  wiredChargingW      Int
  wirelessChargingW   Int
  fullChargeMins      Int

  // Build & Ergonomics
  weightGrams         Int
  thicknessMm         Float
  widthMm             Float
  ipRating            String
  fingerprintType     String   // Ultrasonic vs Optical vs FaceID
  frameMaterial       String
}

model EditorVerdict {
  id                  String          @id @default(cuid())
  deviceId            String
  device              Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  editorId            EditorPersonaId
  score               Float           // 0.0 to 10.0
  headline            String
  analysis            String
  pros                String[]
  cons                String[]
  updatedAt           DateTime        @updatedAt

  @@unique([deviceId, editorId])
}

model EvidenceChunk {
  id                  String   @id @default(cuid())
  deviceId            String
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sourceType          String   // YOUTUBE_TRANSCRIPT, REDDIT_OWNER_THREAD, LAB_BENCHMARK
  sourceTitle         String
  sourceAuthor        String
  sourceUrl           String
  excerpt             String
  topic               String   // THERMALS, CAMERA, BATTERY, BUGS, VALUE
  sentiment           String   // POSITIVE, MIXED, CRITICAL
  verifiedAt          DateTime @default(now())
  // embedding        Unsupported("vector(1536)")?
}

model AffiliateOffer {
  id                  String   @id @default(cuid())
  deviceId            String
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  merchantName        String
  priceUsd            Int
  inStock             Boolean  @default(true)
  affiliateUrl        String
  updatedAt           DateTime @updatedAt
}

model PricePoint {
  id                  String   @id @default(cuid())
  deviceId            String
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  recordedAt          DateTime @default(now())
  priceUsd            Int
  pragmatistScoreAt   Float
}

model EditorialDraft {
  id                  String      @id @default(cuid())
  deviceId            String?
  device              Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  type                String      // LIVING_SCORE_UPDATE, BUG_RADAR_ALERT, NEW_DEVICE_REVIEW, BUYER_GUIDE
  title               String
  summary             String
  leadEditorId        EditorPersonaId
  coEditorId          EditorPersonaId?
  confidenceScore     Int         // 0 to 100
  status              DraftStatus @default(PENDING_REVIEW)
  proposedChangesJson String
  citationsCount      Int
  createdAt           DateTime    @default(now())
}
